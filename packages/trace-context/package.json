{
  "name": "bend-trace-context",
  "version": "0.1.3-dev",
  "description": "W3C Trace Context for Bend, with a JavaScript facade for Node and browser pages",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./javascript/index.d.mts",
      "default": "./javascript/index.mjs"
    },
    "./node": {
      "types": "./javascript/node.d.mts",
      "default": "./javascript/node.mjs"
    },
    "./fetch": {
      "types": "./javascript/fetch.d.mts",
      "default": "./javascript/fetch.mjs"
    }
  }
}
