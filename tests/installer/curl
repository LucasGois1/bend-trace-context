#!/bin/sh
# Control only the download boundary; checksum verification and extraction stay real.
set -eu

output=
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output) output=$2; shift 2 ;;
    --output=*) output=${1#--output=}; shift ;;
    *) shift ;;
  esac
done
[ -n "$output" ] || { echo "The installer must request an output file." >&2; exit 2; }
case "${INSTALLER_TEST_RESPONSE:?}" in
  release) cp "${INSTALLER_TEST_ARCHIVE:?}" "$output" ;;
  corrupt)
    cp "${INSTALLER_TEST_ARCHIVE:?}" "$output"
    # Change only gzip's timestamp, so extraction still succeeds if checksum
    # enforcement regresses. An invalid gzip would also fail at the tar layer.
    printf '\001\002\003\004' | dd of="$output" bs=1 seek=4 conv=notrunc 2>/dev/null
    ;;
  failure)
    printf 'partial download\n' > "$output"
    echo "Controlled download failure." >&2
    exit 22
    ;;
  *) echo "Unknown installer test response." >&2; exit 2 ;;
esac
