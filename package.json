{
  "name": "bend-trace-context-qualification",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@playwright/test": "1.63.0",
    "bend-trace-context": "file:packages/trace-context",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "scripts": {
    "test:node": "node --test --test-reporter=tap tests/javascript/*.test.mjs",
    "build:browser": "./bend examples/javascript/index.html -o \"${BROWSER_OUT:-build/browser}\" && ./bend examples/javascript/fetch.html -o \"${BROWSER_OUT:-build/browser}\" && ./bend tests/browser/pages/entropy.html -o \"${BROWSER_OUT:-build/browser}\"",
    "test:browser": "playwright test"
  }
}
